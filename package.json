{
  "name": "jj-apartment-search",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "synth": "pnpm --filter @jj/infra synth",
    "deploy:dev": "pnpm --filter @jj/infra deploy:dev",
    "deploy:prod": "pnpm --filter @jj/infra deploy:prod",
    "seed:dev": "tsx scripts/seed.ts --env dev"
  },
  "devDependencies": {
    "@jj/shared": "workspace:*",
    "@types/node": "^22.10.2",
    "amazon-cognito-identity-js": "^6.3.12",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
