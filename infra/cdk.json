{
  "app": "npx tsx bin/app.ts",
  "watch": {
    "include": ["bin/**", "lib/**"],
    "exclude": ["node_modules", "cdk.out"]
  },
  "context": {
    "environments": {
      "dev": {
        "region": "eu-central-1",
        "logRetentionDays": 30,
        "removalPolicy": "destroy",
        "enableWaf": false,
        "notify": {
          "mailFrom": "",
          "adminEmail": "",
          "customerUrl": "https://d2sypuxkeexa2n.cloudfront.net",
          "adminUrl": "https://dveqa1ss76yri.cloudfront.net"
        },
        "listingImport": {
          "proxyUrlTemplate": "",
          "aiModel": ""
        }
      },
      "prod": {
        "region": "eu-central-1",
        "logRetentionDays": 180,
        "removalPolicy": "retain",
        "enableWaf": true,
        "alarmEmail": "",
        "domain": null,
        "notify": {
          "mailFrom": "",
          "adminEmail": "",
          "customerUrl": "https://d1czu5odsp4d48.cloudfront.net",
          "adminUrl": "https://d1nxohwg5k95p0.cloudfront.net"
        },
        "listingImport": {
          "proxyUrlTemplate": "",
          "aiModel": ""
        }
      }
    },
    "@aws-cdk/aws-apigateway:usagePlanKeyOrderInsensitiveId": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-apigateway:disableCloudWatchRole": true,
    "@aws-cdk/core:enablePartitionLiterals": true,
    "@aws-cdk/aws-ecs:disableExplicitDeploymentController": true,
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:newStyleStackSynthesis": true
  }
}
