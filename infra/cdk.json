{
  "app": "npx tsx bin/app.ts",
  "watch": {
    "include": ["bin/**", "lib/**"],
    "exclude": ["node_modules", "cdk.out"]
  },
  "context": {
    "environments": {
      "dev": {
        "region": "eu-central-1",
        "logRetentionDays": 30,
        "removalPolicy": "destroy",
        "enableWaf": false,
        "notify": {
          "mailFrom": "",
          "adminEmail": "",
          "customerUrl": "https://d2sypuxkeexa2n.cloudfront.net",
          "adminUrl": "https://dveqa1ss76yri.cloudfront.net"
        },
        "listingImport": {
          "proxyUrlTemplate": "https://app.scrapingbee.com/api/v1/?api_key={key}&render_js=true&premium_proxy=true&country_code=de&url={url}",
          "aiModel": ""
        }
      },
      "prod": {
        "region": "eu-central-1",
        "logRetentionDays": 180,
        "removalPolicy": "retain",
        "enableWaf": true,
        "alarmEmail": "",
        "domain": {
          "zoneName": "genauhere.de",
          "customer": "genauhere.de",
          "customerAliases": ["www.genauhere.de"],
          "admin": "admin.genauhere.de"
        },
        "notify": {
          "mailFrom": "",
          "adminEmail": "",
          "customerUrl": "https://genauhere.de",
          "adminUrl": "https://admin.genauhere.de"
        },
        "listingImport": {
          "proxyUrlTemplate": "https://app.scrapingbee.com/api/v1/?api_key={key}&render_js=true&premium_proxy=true&country_code=de&url={url}",
          "aiModel": ""
        }
      }
    },
    "@aws-cdk/aws-apigateway:usagePlanKeyOrderInsensitiveId": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-apigateway:disableCloudWatchRole": true,
    "@aws-cdk/core:enablePartitionLiterals": true,
    "@aws-cdk/aws-ecs:disableExplicitDeploymentController": true,
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:newStyleStackSynthesis": true
  }
}
